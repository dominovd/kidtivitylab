---
interface Props {
  slug: string;
}

const { slug } = Astro.props;
---

{slug === 'rainy-day' && (
  <svg viewBox="0 0 32 32" aria-hidden="true">
    <path d="M6 17a10 10 0 0 1 20 0H6Z" />
    <path d="M16 7v18a3 3 0 0 0 6 0" />
    <path class="detail" d="M8 6.5 7 9M24 6.5 25 9M3.5 11l2.2 1M28.5 11l-2.2 1" />
  </svg>
)}

{slug === 'indoor' && (
  <svg viewBox="0 0 32 32" aria-hidden="true">
    <path d="m6 15 10-9 10 9v11H6V15Z" />
    <path class="detail" d="M12 26v-8h8v8M4 16 16 5l12 11" />
  </svg>
)}

{slug === 'outdoor' && (
  <svg viewBox="0 0 32 32" aria-hidden="true">
    <circle cx="16" cy="16" r="5.5" />
    <path class="detail" d="M16 3v4M16 25v4M3 16h4M25 16h4M6.8 6.8l2.8 2.8M22.4 22.4l2.8 2.8M25.2 6.8l-2.8 2.8M9.6 22.4l-2.8 2.8" />
  </svg>
)}

{slug === 'road-trip' && (
  <svg viewBox="0 0 32 32" aria-hidden="true">
    <path d="m7 19 2.4-7h13.2l2.4 7" />
    <path d="M5 19h22v6H5v-6Z" />
    <circle cx="9" cy="25" r="2" />
    <circle cx="23" cy="25" r="2" />
    <path class="detail" d="M10 15h12M3 12h3M26 12h3" />
  </svg>
)}

{slug === 'sick-day' && (
  <svg viewBox="0 0 32 32" aria-hidden="true">
    <path d="M16 27S6 21.2 6 13.5C6 9.7 8.7 7 12.2 7c2 0 3.2 1 3.8 2 .6-1 1.8-2 3.8-2C23.3 7 26 9.7 26 13.5 26 21.2 16 27 16 27Z" />
    <path class="detail" d="M16 12v7M12.5 15.5h7" />
  </svg>
)}

{slug === 'quiet-time' && (
  <svg viewBox="0 0 32 32" aria-hidden="true">
    <path d="M25 20.5A9.5 9.5 0 0 1 11.5 7 9.5 9.5 0 1 0 25 20.5Z" />
    <path class="detail" d="m23 6 .7 1.6 1.6.7-1.6.7-.7 1.6-.7-1.6-1.6-.7 1.6-.7L23 6Z" />
  </svg>
)}

<style>
  svg {
    width: 31px;
    height: 31px;
    overflow: visible;
  }
  path,
  circle {
    fill: none;
    stroke: currentColor;
    stroke-width: 2.25;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .detail { stroke-width: 1.8; }
</style>
