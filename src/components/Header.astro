---
const nav = [
  { href: '/#finder', label: 'Find Activities' },
  { href: '/age/3-year-olds/', label: 'By Age' },
  { href: '/situations/rainy-day/', label: 'Situations' },
  { href: '/learn/', label: 'Learning Games', badge: 'New', highlight: true },
  { href: '/printables/', label: 'Printables' },
  { href: '/blog/', label: 'Blog' },
  { href: '/about/', label: 'About' },
];
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="logo" aria-label="Kidtivity Lab — home">
      <img src="/images/brand/logo-mark.svg" alt="" width="46" height="46" />
      <span>Kidtivity <em>Lab</em></span>
    </a>
    <nav aria-label="Main">
      <button class="menu-btn no-print" aria-expanded="false" aria-controls="site-nav">
        <span class="visually-hidden">Menu</span>
        <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>
      </button>
      <ul id="site-nav" class="nav-list">
        {nav.map((item) => (
          <li>
            {item.highlight ? (
              <a href={item.href} class="nav-highlight">
                {item.label}
                {item.badge && <span class="nav-badge">{item.badge}</span>}
              </a>
            ) : (
              <a href={item.href}>{item.label}</a>
            )}
          </li>
        ))}
        <li><a href="/#finder" class="btn btn-outline surprise" data-surprise>Surprise me ✨</a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: color-mix(in srgb, var(--bg) 94%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    z-index: 50;
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 76px;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-family: var(--font-head);
    font-weight: 800;
    font-size: 1.45rem;
    color: var(--text);
    text-decoration: none;
  }
  .logo img { width: 46px; height: 46px; }
  .logo em { color: var(--accent); font-style: normal; }
  .nav-list {
    display: flex;
    align-items: center;
    gap: 1.65rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-list a:not(.btn) {
    color: var(--text);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.94rem;
  }
  .nav-list a { white-space: nowrap; }
  .logo { white-space: nowrap; flex-shrink: 0; }
  .nav-list a:not(.btn):hover { color: var(--accent); }
  @media (max-width: 1400px) {
    .nav-list { gap: 1.1rem; }
  }
  .nav-list a.nav-highlight {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.42rem 0.8rem;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
    font-weight: 800;
    box-shadow: inset 0 0 0 1.5px color-mix(in srgb, var(--accent) 35%, transparent);
    transition: background 0.15s ease, transform 0.15s ease;
  }
  .nav-list a.nav-highlight:hover {
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 18%, var(--surface));
    transform: translateY(-1px);
  }
  .nav-badge {
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    line-height: 1;
    padding: 0.22rem 0.42rem;
    border-radius: 999px;
    background: var(--primary);
    color: #fff;
  }
  .menu-btn {
    display: none;
    background: none;
    border: none;
    color: var(--text);
    min-width: var(--tap);
    min-height: var(--tap);
    cursor: pointer;
  }
  /* the menu (Learning Games pill + Blog) needs ~1300px in one row; below that it folds */
  @media (max-width: 1300px) {
    .menu-btn { display: inline-flex; align-items: center; justify-content: center; }
    .nav-list {
      display: none;
      position: absolute;
      top: 76px;
      left: 0;
      right: 0;
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      flex-direction: column;
      align-items: stretch;
      padding: 1rem;
      gap: 0;
    }
    .nav-list li a { display: block; padding: 0.75rem 0.5rem; }
    .nav-list li a.nav-highlight { display: flex; justify-content: space-between; margin: 0.25rem 0; padding: 0.75rem 0.9rem; border-radius: var(--radius-sm); }
    .nav-list.open { display: flex; }
  }
</style>

<script>
  const btn = document.querySelector('.menu-btn');
  const list = document.getElementById('site-nav');
  btn?.addEventListener('click', () => {
    const open = list?.classList.toggle('open');
    btn.setAttribute('aria-expanded', String(!!open));
  });
</script>
