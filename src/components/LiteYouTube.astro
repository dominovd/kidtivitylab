---
/**
 * LiteYouTube — click-to-load YouTube facade.
 * Ships only a thumbnail + a few lines of JS; the ~500KB YouTube iframe
 * loads ONLY after the user clicks play. Keeps CWV budget intact.
 * Uses youtube-nocookie.com and supports a start offset for compilation videos.
 */
interface Props {
  videoId: string;
  title: string;
  start?: number;
}
const { videoId, title, start = 0 } = Astro.props;
---

<div class="lite-yt" data-id={videoId} data-start={String(start)} data-title={title}>
  <button type="button" class="lite-yt-btn" aria-label={`Play video: ${title}`}>
    <img
      src={`https://i.ytimg.com/vi/${videoId}/hqdefault.jpg`}
      alt=""
      width="480"
      height="360"
      loading="lazy"
      decoding="async"
    />
    <span class="lite-yt-play" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="26" height="26"><path d="M8 5.5v13l11-6.5z" fill="currentColor" /></svg>
    </span>
  </button>
</div>

<style>
  .lite-yt {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: 12px;
    overflow: hidden;
    background: #1a1815;
  }
  .lite-yt :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .lite-yt-btn {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    cursor: pointer;
    background: none;
  }
  .lite-yt-btn img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.25s ease;
  }
  .lite-yt-btn:hover img,
  .lite-yt-btn:focus-visible img {
    transform: scale(1.03);
  }
  .lite-yt-play {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--color-primary, #e2725b);
    color: #fff;
    box-shadow: 0 4px 16px rgb(0 0 0 / 0.35);
    transition: transform 0.15s ease;
  }
  .lite-yt-play svg {
    margin-left: 3px;
  }
  .lite-yt-btn:hover .lite-yt-play,
  .lite-yt-btn:focus-visible .lite-yt-play {
    transform: translate(-50%, -50%) scale(1.08);
  }
</style>

<script>
  for (const el of document.querySelectorAll<HTMLElement>('.lite-yt')) {
    el.querySelector('button')?.addEventListener('click', () => {
      const id = el.dataset.id;
      const start = el.dataset.start ?? '0';
      if (!id) return;
      const iframe = document.createElement('iframe');
      const params = new URLSearchParams({ autoplay: '1', rel: '0', start });
      iframe.src = `https://www.youtube-nocookie.com/embed/${id}?${params}`;
      iframe.title = el.dataset.title ?? 'Video';
      iframe.allow =
        'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      el.replaceChildren(iframe);
    });
  }
</script>
