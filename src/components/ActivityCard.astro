---
import type { Activity } from '../lib/taxonomy';
import { timeLabel, materialsLabel, ageLabel } from '../lib/activities';

interface Props {
  activity: Activity;
}
const { activity: a } = Astro.props;
const artEmoji = a.goals.includes('energy')
  ? '↗'
  : a.goals.includes('calm')
    ? '☁'
    : a.goals.includes('stem')
      ? '✦'
      : a.goals.includes('creative')
        ? '✎'
        : '♡';
---

<article class="card activity-card">
  <a href={`/activities/${a.id}/`}>
    {a.image ? (
      <img src={a.image} alt={a.image_alt ?? a.title} width="400" height="260" loading="lazy" />
    ) : (
      <div class={`img-placeholder art-${a.goals[0] ?? 'play'}`} aria-hidden="true">
        <span>{artEmoji}</span>
      </div>
    )}
    <div class="card-body">
      <h3>{a.title}</h3>
      <p class="muted hook">{a.hook}</p>
      <div class="badges-row">
        <span class="badge badge-age">{ageLabel(a.age_min, a.age_max)}</span>
        <span class="badge badge-time">⏱ {timeLabel(a.time_minutes)}</span>
        <span class="badge badge-materials">{materialsLabel(a.materials)}</span>
      </div>
    </div>
  </a>
</article>

<style>
  .activity-card img,
  .img-placeholder {
    aspect-ratio: 16 / 10;
    width: 100%;
    object-fit: cover;
  }
  .activity-card {
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .activity-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-lg); }
  .img-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.2rem;
    color: var(--accent);
    background:
      radial-gradient(circle at 25% 25%, rgba(255,255,255,.82) 0 8%, transparent 9%),
      linear-gradient(135deg, var(--accent-soft), #f7e9c7);
  }
  .img-placeholder span {
    display: grid;
    place-items: center;
    width: 70px;
    height: 70px;
    border-radius: 24px;
    background: rgba(255,255,255,.72);
    transform: rotate(-6deg);
  }
  .art-energy { background: linear-gradient(135deg, #e4f1ee, #f8dfd5); color: var(--primary); }
  .art-calm { background: linear-gradient(135deg, #e7eef8, #f7e9c7); color: #4f73a7; }
  .art-creative { background: linear-gradient(135deg, #f9e0d7, #f4e8bd); color: var(--primary); }
  .art-stem { background: linear-gradient(135deg, #dcefeb, #e6e9f6); color: var(--accent); }
  .card-body { padding: 1rem 1.05rem 1.15rem; }
  .hook {
    font-size: 0.9rem;
    line-height: 1.45;
    margin-bottom: 0.7rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  h3 { margin-bottom: 0.2rem; }
</style>
