---
import { AGE_GROUPS, SITUATIONS, matchesAge } from '../lib/taxonomy';
import { allActivities, toActivity, MIN_ACTIVITIES_PER_PAGE } from '../lib/activities';

// Only link pages that actually exist (same thin-content guard as page generation) —
// this makes orphan footer links structurally impossible.
const acts = (await allActivities()).map(toActivity);
const ageLinks = AGE_GROUPS.filter(
  (g) => acts.filter((a) => matchesAge(a, g)).length >= MIN_ACTIVITIES_PER_PAGE
);
const situationLinks = SITUATIONS.filter(
  (s) => acts.filter((a) => a.situations.includes(s.slug)).length >= MIN_ACTIVITIES_PER_PAGE
);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <div class="footer-logo">
        <img src="/images/brand/logo-mark.svg" alt="" width="46" height="46" />
        <span>Kidtivity <em>Lab</em></span>
      </div>
      <p class="muted">Simple ideas. Big moments.</p>
    </div>
    <nav aria-label="By age">
      <h3>By age</h3>
      <ul>
        {ageLinks.map((g) => (
          <li><a href={`/age/${g.slug}/`}>{g.title}</a></li>
        ))}
      </ul>
    </nav>
    <nav aria-label="Situations">
      <h3>Situations</h3>
      <ul>
        {situationLinks.map((s) => (
          <li><a href={`/situations/${s.slug}/`}>{s.title}</a></li>
        ))}
      </ul>
    </nav>
    <nav aria-label="Kidtivity Lab">
      <h3>Kidtivity Lab</h3>
      <ul>
        <li><a href="/about/">About</a></li>
        <li><a href="/printables/">Printables</a></li>
        <li><a href="/contact/">Contact</a></li>
        <li><a href="/privacy/">Privacy Policy</a></li>
        <li><a href="/terms/">Terms of Use</a></li>
      </ul>
    </nav>
  </div>
  <p class="container copyright muted">© {year} Kidtivity Lab. All rights reserved.</p>
</footer>

<style>
  .site-footer {
    margin-top: 4rem;
    border-top: 1px solid var(--border);
    background: var(--surface);
    padding-block: 2.5rem 1.5rem;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.35fr repeat(3, 1fr);
    gap: 3rem;
  }
  .footer-logo {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-family: var(--font-head);
    font-weight: 800;
    font-size: 1.35rem;
    margin-bottom: 0.25rem;
  }
  .footer-logo img { width: 44px; height: 44px; }
  .footer-logo em { color: var(--accent); font-style: normal; }
  h3 { font-size: 0.95rem; margin-bottom: 0.5rem; }
  ul { list-style: none; margin: 0; padding: 0; }
  li { margin-bottom: 0.35rem; }
  a { color: var(--text-soft); text-decoration: none; font-size: 0.95rem; }
  a:hover { color: var(--accent); text-decoration: underline; }
  .copyright { margin-top: 2rem; font-size: 0.85rem; }
  @media (max-width: 760px) {
    .footer-grid { grid-template-columns: repeat(2, 1fr); gap: 2rem; }
    .footer-brand { grid-column: 1 / -1; }
  }
</style>
