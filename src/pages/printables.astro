---
import Base from '../layouts/Base.astro';
import EmailCapture from '../components/EmailCapture.astro';
---

<Base
  title="Free Printables for Kids — Kidtivity Lab"
  description="Printable activity cards, scavenger hunts, and checklists — free for subscribers."
>
  <div class="container section" style="max-width:720px">
    <h1>Printables</h1>
    <p>
      Activity card packs, scavenger hunt sheets, and quiet-time checklists — printable in one
      click. Coming soon: subscribe and we'll send the first pack the day it's ready.
    </p>
    <EmailCapture heading="Get the first printable pack" />
  </div>
</Base>
