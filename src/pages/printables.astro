---
import Base from '../layouts/Base.astro';
import EmailCapture from '../components/EmailCapture.astro';
---

<Base
  title="Free Printables for Kids — Kidtivity Lab"
  description="Printable activity cards, scavenger hunts, and checklists — free for subscribers."
  robots="noindex,follow"
>
  <div class="container section" style="max-width:720px">
    <h1>Printables</h1>
    <p>
      Activity card packs, scavenger hunt sheets, and quiet-time checklists — printable in one
      click. The first packs are in the works. Until then, every activity page has a clean print
      stylesheet: open any activity and hit print for a fridge-ready instruction card.
    </p>
    <p><a class="btn btn-primary" href="/#finder">Browse activities</a></p>
    <EmailCapture heading="Get the first printable pack" />
  </div>
</Base>
